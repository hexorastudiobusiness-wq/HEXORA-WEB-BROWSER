<Window
  x:Class="Hexora.Browser.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="HEXORA BROWSER">

  <Grid
    x:Name="RootLayout"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnRootLoaded">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabView
      x:Name="Tabs"
      Grid.Row="0"
      IsAddTabButtonVisible="True"
      AddTabButtonClick="OnAddTabButtonClick"
      SelectionChanged="OnTabSelectionChanged"
      TabCloseRequested="OnTabCloseRequested" />

    <Border
      Grid.Row="1"
      Padding="8"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
          x:Name="BackButton"
          x:Uid="BackButton"
          Width="36"
          Height="36"
          Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon FontSize="16" Glyph="&#xE72B;" />
        </Button>

        <Button
          x:Name="ForwardButton"
          x:Uid="ForwardButton"
          Grid.Column="1"
          Width="36"
          Height="36"
          Command="{x:Bind ViewModel.ForwardCommand}">
          <FontIcon FontSize="16" Glyph="&#xE72A;" />
        </Button>

        <Button
          x:Name="ReloadButton"
          x:Uid="ReloadButton"
          Grid.Column="2"
          Width="36"
          Height="36"
          Command="{x:Bind ViewModel.ReloadCommand}">
          <FontIcon FontSize="16" Glyph="&#xE72C;" />
        </Button>

        <AutoSuggestBox
          x:Name="AddressBox"
          x:Uid="AddressBox"
          Grid.Column="3"
          MinWidth="240"
          HorizontalAlignment="Stretch"
          Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          QueryIcon="Find"
          QuerySubmitted="OnAddressQuerySubmitted" />

        <Button
          x:Name="MenuButton"
          x:Uid="MenuButton"
          Grid.Column="4"
          Width="36"
          Height="36">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem
                x:Name="NewPrivateWindowItem"
                Click="OnNewPrivateWindowClick" />
              <MenuFlyoutSeparator />
              <MenuFlyoutSubItem x:Name="LanguageMenuItem">
                <ToggleMenuFlyoutItem
                  x:Name="EnglishLanguageItem"
                  Text="English"
                  Click="OnLanguageItemClick" />
                <ToggleMenuFlyoutItem
                  x:Name="PersianLanguageItem"
                  Text="فارسی"
                  Click="OnLanguageItemClick" />
                <ToggleMenuFlyoutItem
                  x:Name="ArabicLanguageItem"
                  Text="العربية"
                  Click="OnLanguageItemClick" />
              </MenuFlyoutSubItem>
            </MenuFlyout>
          </Button.Flyout>
          <FontIcon FontSize="16" Glyph="&#xE712;" />
        </Button>
      </Grid>
    </Border>

    <Grid
      x:Name="BrowserHost"
      Grid.Row="2"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

    <InfoBar
      x:Name="StatusBar"
      x:Uid="StatusBar"
      Grid.Row="3"
      IsClosable="True"
      IsOpen="False"
      Severity="Error" />
  </Grid>
</Window>
