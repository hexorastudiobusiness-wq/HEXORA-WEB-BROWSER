<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ always draws a splash icon; this one is empty on purpose.
     The designed splash is the full-screen artwork the app paints itself, and
     an icon here would put a masked shape back in the middle of it — the square
     with sharp corners this replaced. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
