<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: use the Hexora logo, not the launcher icon. -->
    <style name="Theme.HexoraBrowser" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
