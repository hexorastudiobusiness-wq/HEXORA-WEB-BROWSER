<?xml version="1.0" encoding="utf-8"?>
<!-- The Android 12+ splash icon. The background matches the splash window
     colour exactly, which is what removes the visible square: the platform
     masks the icon, and a mask over a background of the same colour shows
     nothing but the mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
