<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launchers (and every OEM skin) mask this icon themselves, so the
     layers are a brand-coloured background and a transparent mark. The plate
     that used to sit behind the logo was opaque white and square: masked, it
     came out as a white square with sharp corners on One UI and HyperOS. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
